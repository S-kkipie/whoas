#!/bin/sh
# A stand-in for gh in the demo sandbox: it answers `gh api user` from the
# login in hosts.yml, the way the real gh does, and never touches the network.
set -eu
dir=${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}
user=$(sed -n 's/^    user: //p' "$dir/hosts.yml" 2>/dev/null | head -n 1)
if [ -z "$user" ]; then
	echo "You are not logged into any GitHub hosts. To log in, run: gh auth login" >&2
	exit 4
fi
case "$*" in
	"api user") printf '{"login":"%s"}\n' "$user" ;;
	"api user --jq .login") printf '%s\n' "$user" ;;
	*)
		echo "fake gh: unsupported: $*" >&2
		exit 1
		;;
esac
