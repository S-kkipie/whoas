#!/bin/sh
# A stand-in for the Vercel CLI in the demo sandbox. `vercel whoami` reads the
# token from auth.json in the --global-config dir (default: the CLI's own dir),
# the way the real vercel does, then looks it up in the table below instead of
# asking the Vercel API, so nothing touches the network.
set -eu
dir=${XDG_DATA_HOME:-$HOME/.local/share}/com.vercel.cli
if [ "${1:-}" = "--global-config" ] && [ $# -ge 2 ]; then
	dir=$2
	shift 2
fi
token=$(sed -n 's/.*"token": *"\([^"]*\)".*/\1/p' "$dir/auth.json" 2>/dev/null | head -n 1)
case $token in
	fake-demo-token-vercel-personal) user=ana-dev email=ana@gmail.com name=Ana ;;
	fake-demo-token-vercel-client) user=client-team email=team@client.dev name="Client Team" ;;
	*)
		echo "Error: No existing credentials found. Please run \`vercel login\`." >&2
		exit 1
		;;
esac
case "$*" in
	whoami) printf '%s\n' "$user" ;;
	"whoami --format json") printf '{"username":"%s","email":"%s","name":"%s"}\n' "$user" "$email" "$name" ;;
	*)
		echo "fake vercel: unsupported: $*" >&2
		exit 1
		;;
esac
