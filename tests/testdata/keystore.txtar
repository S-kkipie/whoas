# The keystore backend chosen when the vault is created is remembered, so
# later runs never probe for one; WHOAS_KEYSTORE still overrides it.
env WHOAS_MASTER_KEY=
env WHOAS_KEYSTORE=passphrase
env WHOAS_PASSPHRASE=correct-horse
env FAKECLI_LOGIN_AS=work
exec whoas add fakecli work
grep '^passphrase$' $WORK/data/keystore

env WHOAS_KEYSTORE=
exec whoas doctor
stdout '^keystore\s+passphrase \('

env WHOAS_KEYSTORE=os
exec whoas doctor
stdout '^keystore\s+os keyring$'
env WHOAS_KEYSTORE=

# unknown content is an error, not a silent fallback
cp bad-keystore $WORK/data/keystore
exec whoas doctor
stdout '^keystore\s+error: .*unknown keystore "keychain"'

-- bad-keystore --
keychain
